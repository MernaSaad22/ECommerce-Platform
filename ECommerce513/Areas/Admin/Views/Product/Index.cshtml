

@model IEnumerable<ProductWithBrandNameWithCategoryNameVM>

@{
    ViewData["Title"] = "Product Management";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">
            <i class="fas fa-boxes me-2"></i>Product Management
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Add New Product
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-table me-1"></i>
            Product Inventory
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover" id="productsTable">
                        <thead class="table-light">
                            <tr>
                                <th width="5%">#</th>
                                <th>Product</th>
                                <th class="text-end">Price</th>
                                <th class="text-center">Stock</th>
                                <th class="text-center">Rating</th>
                                <th class="text-center">Status</th>
                                <th>Category</th>
                                <th>Brand</th>
                                <th width="15%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var counter = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(counter++)</td>
                                    <td>
                                        <div class="d-flex align-items-center">

                                            <div>
                                                <h6 class="mb-0">@item.Name</h6>
                                                <small class="text-muted">ID: @item.Id</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-end fw-bold">@item.Price.ToString("C")</td>
                                    <td class="text-center">
                                        @if (item.Quantity > 10)
                                        {
                                            <span class="badge bg-success">@item.Quantity</span>
                                        }
                                        else if (item.Quantity > 0)
                                        {
                                            <span class="badge bg-warning text-dark">@item.Quantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Out of Stock</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="rating-stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= item.Rate)
                                                {
                                                    <i class="fas fa-star text-warning"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-warning"></i>
                                                }
                                            }
                                        </div>
                                        <small class="text-muted">(@item.Rate.ToString("0.0"))</small>
                                    </td>
                                    <td class="text-center">
                                        @if (item.Status)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.BrandName</td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-primary" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
@*                                             <a href="javascript:;" class="btn btn-sm btn-danger btn-delete"
                                               data-id="@item.Id" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a> *@
@*                                             <a asp-area="Admin"
                                               asp-controller="Product"
                                               asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-danger"
                                               onclick="return confirm('Are you sure you want to delete this product?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </a> *@
                                            <a href="javascript:;"
                                               class="btn btn-sm btn-danger btn-delete"
                                               data-id="@item.Id">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                            <script>
                                                document.addEventListener("DOMContentLoaded", function () {
                                                    const deleteButtons = document.querySelectorAll('.btn-delete');

                                                    deleteButtons.forEach(button => {
                                                        button.addEventListener('click', function () {
                                                            const productId = this.getAttribute('data-id');

                                                            Swal.fire({
                                                                title: 'Are you sure?',
                                                                text: "This action cannot be undone!",
                                                                icon: 'warning',
                                                                showCancelButton: true,
                                                                confirmButtonColor: '#d33',
                                                                cancelButtonColor: '#3085d6',
                                                                confirmButtonText: 'Yes, delete it!',
                                                                cancelButtonText: 'Cancel'
                                                            }).then((result) => {
                                                                if (result.isConfirmed) {
                                                                    // Redirect to delete URL
                                                                    window.location.href = `/Admin/Product/Delete/${productId}`;
                                                                }
                                                            });
                                                        });
                                                    });
                                                });
                                            </script>




                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center py-4">
                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                    <h4>No Products Found</h4>
                    <p class="mb-0">There are currently no products in the inventory.</p>
                    <a asp-action="Create" class="btn btn-primary mt-3">
                        <i class="fas fa-plus-circle me-1"></i> Add Your First Product
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTable
            $('#productsTable').DataTable({
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: [0, 8] },
                    { className: "dt-center", targets: [3, 4, 5] },
                    { className: "dt-right", targets: [2] }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search products...",
                }
            });

            // SweetAlert for delete confirmation
            $('.btn-delete').on('click', function() {
                const productId = $(this).data('id');

                Swal.fire({
                    title: 'Confirm Product Deletion',
                    html: `Are you sure you want to delete this product?<br><br>
                          <small class="text-muted">This action cannot be undone and will remove all associated data.</small>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel',
                    backdrop: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = `/Admin/Product/Delete/${productId}`;
                    }
                });
            });
        });
    </script>
}

<style>
    .rating-stars {
        display: inline-block;
        font-size: 0.9rem;
    }

    .table th {
        white-space: nowrap;
    }

    .avatar img {
        object-fit: cover;
    }
</style>


