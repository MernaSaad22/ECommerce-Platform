



@model IEnumerable<Category>

@{
    ViewData["Title"] = "Category Management";
}

@section Styles {
    <style>
        .category-table th {
            white-space: nowrap;
        }

        .description-cell {
            max-width: 300px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .badge-active {
            background-color: #28a745;
        }

        .badge-inactive {
            background-color: #dc3545;
        }

        .action-buttons {
            min-width: 150px;
        }
    </style>
}

@section Scripts {
    @if (TempData["Notification"] is not null)
    {
        <script>
            toastr.success('@TempData["Notification"]')
        </script>
    }

    <script>
        $(document).ready(function () {
            // Initialize DataTable
            $('#categoriesTable').DataTable({
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: [4] },
                    { className: "text-center", targets: [3] }
                ],
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search categories...",
                }
            });

            // Delete confirmation
            $('.btn-delete').on('click', function() {
                const categoryId = $(this).data('id');

                Swal.fire({
                    title: 'Confirm Deletion',
                    html: `Are you sure you want to delete this category?<br><br>
                          <small class="text-muted">This action cannot be undone.</small>`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Delete',
                    cancelButtonText: 'Cancel',
                    backdrop: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = `/Admin/Category/Delete/${categoryId}`;
                    }
                });
            });
        });
    </script>
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mt-4">
            <i class="fas fa-tags me-2"></i>@ViewData["Title"]
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Add Category
        </a>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-table me-1"></i>
            Categories List
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table id="categoriesTable" class="table table-striped table-hover">
                        <thead class="table-light">
                            <tr>
                                <th width="5%">#</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th width="10%">Status</th>
                                <th width="15%">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var counter = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@(counter++)</td>
                                    <td>@item.Name</td>
                                    <td class="description-cell" title="@item.Description">
                                        @(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(item.Status ? "badge-active" : "badge-inactive")">
                                            @(item.Status ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="action-buttons">
                                        <div class="d-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning" title="Edit">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                          @*   <a href="javascript:;" class="btn btn-sm btn-danger btn-delete"
                                               data-id="@item.Id" title="Delete">
                                                <i class="fas fa-trash-alt"></i>
                                            </a> *@

                                            <a href="javascript:;"
                                               class="btn btn-sm btn-danger btn-delete"
                                               data-id="@item.Id">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                            <script>
                                                document.addEventListener("DOMContentLoaded", function () {
                                                    const deleteButtons = document.querySelectorAll('.btn-delete');

                                                    deleteButtons.forEach(button => {
                                                        button.addEventListener('click', function () {
                                                            const productId = this.getAttribute('data-id');

                                                            Swal.fire({
                                                                title: 'Are you sure?',
                                                                text: "This action cannot be undone!",
                                                                icon: 'warning',
                                                                showCancelButton: true,
                                                                confirmButtonColor: '#d33',
                                                                cancelButtonColor: '#3085d6',
                                                                confirmButtonText: 'Yes, delete it!',
                                                                cancelButtonText: 'Cancel'
                                                            }).then((result) => {
                                                                if (result.isConfirmed) {
                                                                    // Redirect to delete URL
                                                                    window.location.href = `/Admin/Category/Delete/${productId}`;
                                                                }
                                                            });
                                                        });
                                                    });
                                                });
                                            </script>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center py-4">
                    <i class="fas fa-info-circle fa-2x mb-3"></i>
                    <h4>No Categories Found</h4>
                    <p class="mb-0">There are currently no categories in the system.</p>
                    <a asp-action="Create" class="btn btn-primary mt-3">
                        <i class="fas fa-plus-circle me-1"></i> Create First Category
                    </a>
                </div>
            }
        </div>
    </div>
</div>