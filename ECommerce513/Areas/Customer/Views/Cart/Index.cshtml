@model IEnumerable<Cart>

<div class="container py-5">
    <div class="card shadow border-0 rounded-3">
        <!-- Cart Header -->
        <div class="card-header bg-dark text-white py-3">
            <div class="row align-items-center">
                <div class="col-6">
                    <h5 class="mb-0">
                        <i class="bi bi-cart3 me-2"></i>Your Shopping Cart
                    </h5>
                </div>
                <div class="col-6 text-end">
                    <span class="badge bg-primary rounded-pill px-3 py-2">
                        @Model.Count() @(Model.Count() == 1 ? "Item" : "Items")
                    </span>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- Continue Shopping Button -->
            <div class="row mb-4">
                <div class="col-12">
                    <a href="/" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            </div>

            <!-- Cart Items -->
            @if (Model.Any())
            {
                <div class="row">
                    <div class="col-12">
                        @foreach (var item in Model)
                        {
                            <div class="row border-bottom pb-3 mb-4 align-items-center">
                                <!-- Product Image -->
                                <div class="col-md-2 col-4 mb-3 mb-md-0">
                                    <img src="~/images/@item.Product.MainImg"
                                         class="img-fluid rounded-3 shadow-sm"
                                         alt="@item.Product.Name" />
                                </div>

                                <!-- Product Info -->
                                <div class="col-md-4 col-8">
                                    <h5 class="text-primary">@item.Product.Name</h5>
                                    <p class="text-muted small mb-2">@item.Product.Description</p>
                                    <span class="badge bg-light text-dark">
                                        @item.Product.Category?.Name
                                    </span>
                                </div>

                                <!-- Quantity Controls -->
                                <div class="col-md-3 col-12 mt-3 mt-md-0">
                                    <div class="d-flex align-items-center justify-content-center">
                                        <a asp-action="DecrementCount" asp-route-productId="@item.ProductId"
                                           class="btn btn-outline-secondary px-3">
                                            <i class="bi bi-dash-lg"></i>
                                        </a>

                                        <span class="mx-3 fw-bold">@item.Count</span>

                                        <a asp-action="IncrementCount" asp-route-productId="@item.ProductId"
                                           class="btn btn-outline-secondary px-3">
                                            <i class="bi bi-plus-lg"></i>
                                        </a>
                                    </div>
                                </div>

                                <!-- Price and Remove -->
                                <div class="col-md-3 col-12 mt-3 mt-md-0 text-md-end">
                                    <div class="d-flex flex-column">
                                        <h5 class="mb-2">
                                            @((item.Product.Price * item.Count).ToString("C"))
                                        </h5>
                                        <small class="text-muted">
                                            @item.Product.Price.ToString("C") each
                                        </small>
                                        <a asp-action="DeleteItem" asp-route-productId="@item.ProductId"
                                           class="btn btn-sm btn-outline-danger mt-2 align-self-md-end">
                                            <i class="bi bi-trash me-1"></i>Remove
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Cart Summary -->
                <div class="row mt-4">
                    <div class="col-lg-5 offset-lg-7">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title text-uppercase text-muted mb-3">Order Summary</h5>
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Subtotal</span>
                                    <span>@ViewBag.totalPrice.ToString("C")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3">
                                    <span>Shipping</span>
                                    <span class="text-success">FREE</span>
                                </div>
                                <hr>
                                <div class="d-flex justify-content-between fw-bold fs-5">
                                    <span>Total</span>
                                    <span>@ViewBag.totalPrice.ToString("C")</span>
                                </div>

                                <div class="d-grid mt-4">
                                    <a href="/Customer/Cart/Pay" class="btn btn-primary btn-lg py-3">
                                        <i class="bi bi-lock-fill me-2"></i>Secure Checkout
                                    </a>
                                </div>

                                <div class="text-center mt-3">
                                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/apple/apple-original.svg" width="24" class="me-2" />
                                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" width="24" class="me-2" />
                                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/visa/visa-original.svg" width="24" class="me-2" />
                                    <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mastercard/mastercard-original.svg" width="24" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x display-1 text-muted"></i>
                    <h3 class="mt-3">Your cart is empty</h3>
                    <p class="text-muted">Start shopping to add items to your cart</p>
                    <a href="/" class="btn btn-primary mt-3">
                        <i class="bi bi-arrow-left me-2"></i>Continue Shopping
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .quantity-controls .btn {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-header {
        background: linear-gradient(135deg, #343a40 0%, #212529 100%);
    }

    .btn-checkout {
        background: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
        border: none;
        transition: all 0.3s ease;
    }

        .btn-checkout:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
        }
</style>